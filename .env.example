# ─── Database ──────────────────────────────
DATABASE_URL=file:./db/custom.db

# ─── Authentication ────────────────────────
# REQUIRED in production. Fallback only for development.
JWT_SECRET=

# ─── Razorpay (Payment Gateway) ───────────
# Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── API Service ───────────────────────────
# URL of the Hono API service (used for proxying)
API_SERVICE_URL=http://localhost:3001

# ─── Optional ──────────────────────────────
# NEXT_PUBLIC_API_URL=
# REDIS_URL=
# SENTRY_DSN=
