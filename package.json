{
  "name": "bookmyservice",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node launcher.js",
    "dev:frontend": "cd frontend && npx vite --host",
    "dev:backend": "cd mini-services/api-service && npx tsx index.ts",
    "build": "cd frontend && npm install && npx vite build",
    "lint": "next lint",
    "db:push": "cd database && npx prisma db push",
    "db:seed": "cd database && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.6.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "prisma": "6.6.0",
    "typescript": "6.0.3"
  }
}
