{
  "name": "bookmyservice",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node launcher.js",
    "dev:frontend": "cd frontend && npx vite --host",
    "dev:backend": "cd mini-services/api-service && npx tsx index.ts",
    "build": "cd frontend && npm install && npx vite build",
    "lint": "next lint",
    "db:push": "cd database && npx prisma db push",
    "db:seed": "cd database && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "6.6.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "25.8.0",
    "@types/react": "19.2.15",
    "postcss": "^8.5.15",
    "prisma": "6.6.0",
    "tailwindcss": "4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3"
  }
}
