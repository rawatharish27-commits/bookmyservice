generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  phone            String   @unique
  passwordHash     String
  name             String
  roleId           Int
  role             Role     @relation(fields: [roleId], references: [id])
  status           String   @default("PENDING") // ACTIVE, BLOCKED, PENDING, SUSPENDED
  emailVerified    Boolean  @default(false)
  phoneVerified    Boolean  @default(false)
  profileImageUrl  String?
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  lastLoginAt      DateTime?
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  providerKyc      ProviderKyc[]
  services         Service[]
  clientBookings   Booking[]      @relation("ClientBookings")
  providerBookings Booking[]      @relation("ProviderBookings")
  reviewsGiven     Review[]       @relation("ReviewGiven")
  reviewsReceived  Review[]       @relation("ReviewReceived")
  notifications    Notification[]
  negotiations     Negotiation[]
  disputesRaised   Dispute[]      @relation("DisputeRaised")
  disputesAssigned Dispute[]      @relation("DisputeAssigned")
  disputeMessages  DisputeMessage[] @relation("DisputeMessagesSent")
  adminLogs        AdminLog[]
  favorites        Favorite[]
  referralsGiven   Referral[]      @relation("ReferralsGiven")
  referralsReceived Referral[]     @relation("ReferralsReceived")
  areaManager      AreaManager?
  commissions      Commission[]    @relation("CommissionsEarned")

  // Wallet relations
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  payoutRequests     PayoutRequest[]

  @@index([deletedAt])
}

model ProviderKyc {
  id                String   @id @default(cuid())
  providerId        String   @unique
  provider          User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documentType      String   // AADHAAR, PAN, DRIVING_LICENSE, PASSPORT
  documentNumber    String
  documentFrontUrl  String
  documentBackUrl   String?
  selfieUrl         String
  verificationStatus String  @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedBy        String?
  verifiedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ServiceCategory {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  slug          String   @unique
  description   String?
  iconUrl       String?
  icon          String?  // Lucide icon name
  parentId      Int?     
  parent        ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      ServiceCategory[] @relation("CategoryHierarchy")
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services     Service[]
  subcategories ServiceSubcategory[]
}

model ServiceSubcategory {
  id           Int             @id @default(autoincrement())
  categoryId   Int
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  isActive     Boolean         @default(true)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  services     Service[]

  @@unique([categoryId, slug])
}

model Service {
  id                  String   @id @default(cuid())
  providerId          String
  provider            User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId          Int
  category            ServiceCategory @relation(fields: [categoryId], references: [id])
  subcategoryId       Int?
  subcategory         ServiceSubcategory? @relation(fields: [subcategoryId], references: [id])
  title               String
  description         String
  basePrice           Float
  priceNegotiable     Boolean  @default(false)
  serviceDurationMinutes Int?
  serviceAreaRadiusKm Int      @default(10)
  latitude            Float?
  longitude           Float?
  address             String?
  city                String?
  state               String?
  country             String?
  pincode             String?
  images              String?  // JSON array of image URLs
  isActive            Boolean  @default(false)
  isApproved          Boolean  @default(false)
  approvalStatus      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  averageRating       Float    @default(0)
  totalBookings       Int      @default(0)
  totalReviews        Int      @default(0)
  seoTitle            String?
  seoDescription      String?
  deletedAt           DateTime? // Soft delete
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  availability        ServiceAvailability[]
  bookings            Booking[]
  reviews             Review[]
  negotiations        Negotiation[]
  favorites           Favorite[]

  @@index([deletedAt])
}

model ServiceAvailability {
  id                String   @id @default(cuid())
  serviceId         String
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  dayOfWeek         Int      // 0-6 (Sun-Sat)
  startTime         String   // HH:mm format
  endTime           String   // HH:mm format
  isAvailable       Boolean  @default(true)
  maxBookingsPerSlot Int    @default(1)
  createdAt         DateTime @default(now())
}

model Booking {
  id                 String   @id @default(cuid())
  bookingNumber      String   @unique
  clientId           String
  client             User     @relation("ClientBookings", fields: [clientId], references: [id])
  providerId         String
  provider           User     @relation("ProviderBookings", fields: [providerId], references: [id])
  serviceId          String
  service            Service  @relation(fields: [serviceId], references: [id])
  status             String   @default("PENDING") // PENDING, ASSIGNED, ACCEPTED, ON_THE_WAY, ARRIVED, IN_PROGRESS, COMPLETED, CANCELLED, REFUNDED
  scheduledDate      String   // YYYY-MM-DD
  scheduledTime      String   // HH:mm
  serviceAddress     String
  serviceLatitude    Float?
  serviceLongitude   Float?
  distanceKm         Float?
  basePrice          Float
  negotiatedPrice    Float?
  finalPrice         Float
  platformFee        Float    @default(5.0)
  providerEarnings   Float?
  specialInstructions String?
  cancellationReason String?
  cancelledBy        String?
  cancelledAt        DateTime?
  completedAt        DateTime?
  paymentStatus      String   @default("PENDING") // PENDING, PAID, REFUNDED, FAILED
  deletedAt          DateTime? // Soft delete
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Booking Lifecycle Timestamps
  assignedAt         DateTime?
  acceptedAt         DateTime?
  onTheWayAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?

  // Assigned Technician
  technicianId       String?

  // Booking Type
  bookingType        String   @default("NORMAL") // NORMAL, EMERGENCY, AMC

  // OTP Verification
  otpCode            String?
  otpVerified        Boolean  @default(false)
  otpVerifiedAt      DateTime?

  // Warranty
  warrantyDays       Int      @default(90)
  warrantyExpiresAt  DateTime?

  // Coupon
  couponId           String?
  couponDiscount     Float    @default(0)

  // Relations
  payment            Payment?
  review             Review?
  negotiations      Negotiation[]
  disputes           Dispute[]
  timeline           BookingTimeline[]
  invoice            Invoice?

  @@index([deletedAt])
  @@index([status])
  @@index([bookingType])
  @@index([technicianId])
  @@index([scheduledDate])
}

model Payment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount          Float
  currency        String   @default("INR")
  paymentMethod   String?  // CARD, UPI, WALLET, NET_BANKING
  gateway         String?  // RAZORPAY, STRIPE
  gatewayOrderId  String?
  gatewayPaymentId String?
  status          String   @default("CREATED") // CREATED, PROCESSING, SUCCESS, FAILED, REFUNDED
  refundAmount    Float?
  refundReason    String?
  refundedAt      DateTime?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User     @relation("ReviewGiven", fields: [reviewerId], references: [id])
  reviewedId   String
  reviewed     User     @relation("ReviewReceived", fields: [reviewedId], references: [id])
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  rating       Int      // 1-5
  comment      String?
  images       String?  // JSON array
  isVerified   Boolean  @default(false)
  isFlagged    Boolean  @default(false)
  flagReason   String?
  adminResponse String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Negotiation {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  proposedBy    String
  proposer      User     @relation(fields: [proposedBy], references: [id])
  proposedPrice Float
  message       String?
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTER
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
}

model Dispute {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  raisedBy      String
  raiser        User     @relation("DisputeRaised", fields: [raisedBy], references: [id])
  disputeType   String   // PAYMENT, SERVICE_QUALITY, NO_SHOW, CANCELLATION, OTHER
  description   String
  evidence      String?  // JSON array of evidence URLs
  status        String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  assignedTo    String?
  assignee      User?    @relation("DisputeAssigned", fields: [assignedTo], references: [id])
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      DisputeMessage[]
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("DisputeMessagesSent", fields: [senderId], references: [id])
  message     String
  attachments String?  // JSON array
  createdAt   DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  actionUrl  String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())
}

model Faq {
  id           Int      @id @default(autoincrement())
  category     String
  question     String
  answer       String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LegalPage {
  id            Int      @id @default(autoincrement())
  pageType      String   @unique // TERMS, PRIVACY, REFUND, COOKIES
  title         String
  content       String
  version       String?
  effectiveDate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SeoMetadata {
  id            Int      @id @default(autoincrement())
  pageType      String
  pageId        String?
  title         String?
  description   String?
  keywords      String?
  canonicalUrl  String?
  ogImage       String?
  schemaMarkup String?  // JSON
  indexed       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RevenueStream {
  id                      Int      @id @default(autoincrement())
  streamType              String
  description             String?
  revenueModel            String?  // COMMISSION, SUBSCRIPTION, ADVERTISING, FEATURED_LISTING, PREMIUM, REFERRAL, API_ACCESS, DATA_LICENSING
  status                  String   @default("ACTIVE") // ACTIVE, INACTIVE, PLANNED
  estimatedMonthlyRevenue Float?
  createdAt               DateTime @default(now())
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    String?  // JSON
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, serviceId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String   // User who referred
  referrer        User     @relation("ReferralsGiven", fields: [referrerId], references: [id])
  referredEmail   String?  // Email of referred person
  referredPhone   String?  // Phone of referred person
  referredName    String?  // Name of referred person
  referredUserId  String?  // If they joined, link to their account
  referredUser    User?    @relation("ReferralsReceived", fields: [referredUserId], references: [id])
  referralCode    String   @unique // Unique referral code
  referralType    String   @default("PROVIDER") // PROVIDER, CUSTOMER, AREA_MANAGER
  source          String   @default("WHATSAPP") // WHATSAPP, WEBSITE, DIRECT, SOCIAL
  status          String   @default("PENDING") // PENDING, REGISTERED, ACTIVE, COMPLETED, EXPIRED
  rewardType      String?  // COMMISSION, CASH, CREDIT
  rewardAmount    Float?   @default(0)
  commissionRate  Float    @default(0.05) // 5% default commission
  totalEarnings   Float    @default(0)
  totalBookings   Int      @default(0)
  message         String?  // Custom referral message
  expiresAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  commissions     Commission[]
}

model AreaManager {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCity      String
  assignedState     String?
  assignedPincode   String?
  assignedLatitude  Float?
  assignedLongitude Float?
  serviceRadiusKm   Float    @default(20)
  targetProviders   Int      @default(20)
  targetCustomers   Int      @default(100)
  currentProviders  Int      @default(0)
  currentCustomers  Int      @default(0)
  commissionBalance Float    @default(0)
  totalEarnings     Float    @default(0)
  commissionRate    Float    @default(0.03) // 3% commission on all bookings in area
  status            String   @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  joinedAt          DateTime @default(now())
  activatedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceAreas      ServiceArea[]
}

model ServiceArea {
  id              String   @id @default(cuid())
  city            String
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  radiusKm        Float    @default(20)
  isActive        Boolean  @default(false)
  providerCount   Int      @default(0)
  customerCount   Int      @default(0)
  bookingCount    Int      @default(0)
  targetProviders Int      @default(20)
  targetCustomers Int      @default(100)
  launchDate      DateTime?
  areaManagerId   String?
  areaManager     AreaManager? @relation(fields: [areaManagerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([city, pincode])
}

model Commission {
  id              String   @id @default(cuid())
  userId          String   // Who earns the commission
  user            User     @relation("CommissionsEarned", fields: [userId], references: [id])
  bookingId       String?  // Related booking
  referralId      String?  // Related referral
  referral        Referral? @relation(fields: [referralId], references: [id])
  commissionType  String   // REFERRAL, AREA_MANAGER, PLATFORM
  amount          Float
  rate            Float    // Commission rate applied
  baseAmount      Float    // Base amount commission was calculated on
  status          String   @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VisitorSession {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  ipAddress    String?
  userAgent    String?
  page         String?
  referrer     String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
}

// ============================================
// Wallet System
// ============================================

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Float    @default(0)
  cashbackBalance Float    @default(0)
  promoBalance    Float    @default(0)
  totalDeposited  Float    @default(0)
  totalWithdrawn  Float    @default(0)
  totalSpent      Float    @default(0)
  totalEarned     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   // CREDIT, DEBIT
  category      String   // CASHBACK, REFUND, PROMO, EARNING, WITHDRAWAL, PAYMENT, PAYOUT, REFERRAL
  amount        Float
  description   String
  referenceId   String?
  referenceType String?  // BOOKING, PAYOUT, REFERRAL, COUPON
  status        String   @default("COMPLETED") // PENDING, COMPLETED, FAILED, CANCELLED
  metadata      String?  // JSON
  createdAt     DateTime @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([category])
  @@index([referenceId])
}

// ============================================
// Coupon System
// ============================================

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   // PERCENTAGE, FIXED
  discountValue   Float
  minOrderAmount  Float    @default(0)
  maxDiscount     Float?
  usageLimit      Int?
  usageCount      Int      @default(0)
  perUserLimit    Int      @default(1)
  validFrom       DateTime
  validTo         DateTime
  applicableType  String   @default("ALL") // ALL, FIRST_BOOKING, SPECIFIC_CATEGORY, SPECIFIC_SERVICE
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usages          CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validTo])
}

model CouponUsage {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  bookingId       String
  discountApplied Float
  createdAt       DateTime @default(now())

  @@unique([couponId, userId, bookingId])
  @@index([couponId])
  @@index([userId])
  @@index([bookingId])
}

// ============================================
// Invoice System
// ============================================

model Invoice {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique
  clientId       String
  providerId     String
  subtotal       Float
  gstAmount      Float    @default(0)
  gstRate        Float    @default(18)
  discountAmount Float    @default(0)
  totalAmount    Float
  gstin          String?
  hsnCode        String?
  invoiceDate    DateTime @default(now())
  pdfUrl         String?
  status         String   @default("GENERATED") // GENERATED, SENT, PAID, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bookingId])
  @@index([invoiceNumber])
  @@index([clientId])
  @@index([providerId])
}

// ============================================
// Payout System
// ============================================

model PayoutRequest {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  amount           Float
  method           String    // BANK_TRANSFER, UPI
  status           String    @default("PENDING") // PENDING, APPROVED, PROCESSING, COMPLETED, REJECTED
  bankRef          String?
  processedBy      String?
  processedAt      DateTime?
  rejectionReason  String?
  metadata         String?   // JSON
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// Booking Timeline
// ============================================

model BookingTimeline {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      String
  description String?
  performedBy String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}
