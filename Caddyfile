:81 {
	# ─── Security Headers ────────────────────────────────
	header {
		# Prevent MIME-type sniffing
		X-Content-Type-Options nosniff
		# Prevent clickjacking
		X-Frame-Options DENY
		# XSS protection
		X-XSS-Protection "1; mode=block"
		# Referrer policy
		Referrer-Policy strict-origin-when-cross-origin
		# Disable client features not needed
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# HSTS (enable after confirming HTTPS works)
		# Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	# ─── Gzip Compression ────────────────────────────────
	encode gzip {
		minimum_length 256
	}

	# ─── Cache Headers for Static Assets ─────────────────
	@static_assets path *.js *.css *.png *.jpg *.jpeg *.svg *.ico *.woff *.woff2 *.webp
	header @static_assets Cache-Control "public, max-age=31536000, immutable"

	# ─── No-Cache for API & HTML ─────────────────────────
	@api_html path /api/* *.html
	header @api_html Cache-Control "no-store, no-cache, must-revalidate"

	# ─── Rate Limiting Hints ─────────────────────────────
	# Production rate limiting should be configured at the
	# infrastructure level (e.g., Cloudflare, nginx limit_req,
	# or Caddy's rate_limit module). Recommended limits:
	#   - /api/contact: 3 req/min per IP
	#   - /api/auth/*:  10 req/min per IP
	#   - /api/*:       60 req/min per IP
	#   - Global:       200 req/min per IP
	#
	# Caddy rate_limit module (requires plugin build):
	#   rate_limit { zone static_zone 10r/s key {remote_host} }
	#
	# Alternative: Use Cloudflare Rate Limiting rules for
	# managed protection without custom Caddy builds.

	@transform_port_query {
		query XTransformPort=*
	}

	@api path /api/*

	handle @transform_port_query {
		reverse_proxy localhost:{query.XTransformPort} {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle @api {
		reverse_proxy localhost:3001 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
