{
  "name": "bookmyservice-backend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --format=esm",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.18",
    "@prisma/client": "6",
    "@prisma/adapter-pg": "6",
    "pg": "^8.20.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/bcryptjs": "^2.4.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "eslint": "^9",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.59.3"
  }
}