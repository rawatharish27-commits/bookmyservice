# PostgreSQL Database Connection String
# ====================================================
# Replace with your PostgreSQL connection string:
#
# Option 1: Neon (Free) - https://neon.tech
#   DATABASE_URL=postgres://username:password@ep-xxx.region.aws.neon.tech/bookyourservice?sslmode=require
#
# Option 2: Supabase (Free) - https://supabase.com
#   DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#
# Option 3: Railway (Free tier) - https://railway.app
#   DATABASE_URL=postgresql://postgres:password@xxx.railway.app:5432/railway
#
# Option 4: Local PostgreSQL
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookyourservice
#
# Option 5: Any other PostgreSQL provider
#   DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
# ====================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookyourservice
